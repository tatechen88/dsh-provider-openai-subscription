{
  "name": "dsh-provider-openai-subscription",
  "version": "1.4.0",
  "description": "Independent OpenAI/ChatGPT OAuth provider, model adapter and balance plugin for DeepSeek Harness. Composition and bootstrap never block DSH startup; a failed activation is reported through DSH's own optional-entry audit.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/client.js",
    "./rescue": "./src/rescue.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-openai-subscription-rescue": "src/rescue.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test test/*.e2e.mjs",
    "test:integration": "node scripts/integration-smoke.mjs",
    "test:install": "node scripts/install-smoke.mjs",
    "test:integration:strict": "node scripts/integration-smoke.mjs --require-dsh",
    "test:install:strict": "node scripts/install-smoke.mjs --require-tools",
    "test:release": "npm run test && npm run test:integration:strict",
    "check": "node scripts/check-syntax.mjs && node --test test/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "openai",
    "chatgpt",
    "oauth",
    "codex",
    "balance"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.6-alpha.1"
  }
}
