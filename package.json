{
  "name": "dsh-provider-openai-subscription",
  "version": "1.4.0",
  "description": "Independent OpenAI/ChatGPT OAuth provider, model adapter and balance plugin for DeepSeek Harness. Safe bootstrap: a plugin failure must never prevent DSH from starting.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/client.js",
    "./rescue": "./src/rescue.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-openai-subscription-rescue": "src/rescue.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test test/*.e2e.mjs",
    "test:integration": "node scripts/integration-smoke.mjs",
    "test:install": "node scripts/install-smoke.mjs",
    "check": "node scripts/check-syntax.mjs && node --test test/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "openai",
    "chatgpt",
    "oauth",
    "codex",
    "balance"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
