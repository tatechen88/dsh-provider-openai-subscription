{
  "name": "dsh-provider-openai-subscription",
  "version": "2.0.0",
  "description": "Host-only OpenAI/ChatGPT subscription provider for DeepSeek Harness: a model adapter, an authorization flow and agent tools, with no browser half. Composition and bootstrap never block DSH startup; a failed activation is reported through DSH's own optional-entry audit.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./rescue": "./src/rescue.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-openai-subscription-rescue": "src/rescue.mjs"
  },
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tatechen88/dsh-provider-openai-subscription.git"
  },
  "bugs": {
    "url": "https://github.com/tatechen88/dsh-provider-openai-subscription/issues"
  },
  "homepage": "https://github.com/tatechen88/dsh-provider-openai-subscription#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test test/*.e2e.mjs",
    "test:integration": "node scripts/integration-smoke.mjs",
    "test:install": "node scripts/install-smoke.mjs",
    "test:web": "node scripts/web-smoke.mjs",
    "test:integration:strict": "node scripts/integration-smoke.mjs --require-dsh",
    "test:install:strict": "node scripts/install-smoke.mjs --require-tools",
    "test:web:strict": "node scripts/web-smoke.mjs --require-dsh",
    "test:headless": "node scripts/headless-smoke.mjs",
    "test:headless:strict": "node scripts/headless-smoke.mjs --require-dsh",
    "test:release": "npm run test && npm run test:integration:strict && npm run test:web:strict && npm run test:headless:strict",
    "check": "node scripts/check-syntax.mjs && node --test test/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "openai",
    "chatgpt",
    "oauth",
    "codex",
    "balance"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.6-alpha.1"
  }
}
